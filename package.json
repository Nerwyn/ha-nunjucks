{
	"name": "ha-nunjucks",
	"version": "1.7.7",
	"description": "Wrapper for nunjucks for use with Home Assistant frontend custom components to render templates",
	"main": "./dist/index.js",
	"files": [
		"dist/**"
	],
	"type": "module",
	"scripts": {
		"test": "ts-mocha tests/**/*.test.ts --require tests/fixtures.mjs",
		"build": "tsc",
		"prelint": "tsc --noemit",
		"lint": "eslint --config ./eslint.config.js",
		"setup": "git config --add core.hooksPath githooks && chmod +x githooks/pre-commit && npm i"
	},
	"lint-staged": {
		"*": "prettier -w"
	},
	"author": "Nerwyn",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Nerwyn/ha-nunjucks.git"
	},
	"bugs": {
		"url": "https://github.com/Nerwyn/ha-nunjucks/issues"
	},
	"homepage": "https://github.com/Nerwyn/ha-nunjucks#readme",
	"dependencies": {
		"buffer": "^6.0.3",
		"create-hash": "^1.2.0",
		"home-assistant-js-websocket": "latest",
		"mersenne-twister": "^1.1.0",
		"nunjucks": "^3.2.4",
		"python-struct": "^1.1.3",
		"slugify": "^1.6.9",
		"stream": "npm:stream-browserify@^3.0.0",
		"ts-py-datetime": "latest"
	},
	"devDependencies": {
		"@types/create-hash": "^1.2.6",
		"@types/mersenne-twister": "^1.1.7",
		"@types/mocha": "^10.0.10",
		"@types/nunjucks": "^3.2.6",
		"@types/python-struct": "^1.0.5",
		"@typescript-eslint/eslint-plugin": "^8.62.0",
		"@typescript-eslint/parser": "^8.62.0",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"global-jsdom": "^29.0.0",
		"lint-staged": "^17.0.8",
		"mocha": "^11.7.6",
		"prettier": "^3.9.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"ts-loader": "^9.2.1",
		"ts-mocha": "^11.1.0",
		"ts-node": "^10.9.2",
		"tsx": "latest",
		"typescript": "latest"
	}
}
